import 'package:flutter/material.dart'; // Flutter’ın temel UI bileşenlerini sağlar.
import 'package:flutter/services.dart'; // SystemNavigator.pop() ve HapticFeedback gibi sistem fonksiyonları için.
import 'project_form_page.dart'; // "Yeni Proje Oluştur" sayfasına geçiş için gerekli sayfa importu.
import 'dart:io'
    show
        Platform,
        exit; // Platform tespiti (Android, iOS, Windows...) ve masaüstü çıkışı için 'exit(0)' kullanımı.

// 🏠 Ana giriş ekranı widget'ı — StatelessWidget, çünkü dinamik veri değişimi yok.
class HomePage extends StatelessWidget {
  const HomePage({super.key});

  @override
  Widget build(BuildContext context) {
    // 📏 Ekran boyutlarını alıyoruz.
    final Size screenSize = MediaQuery.of(context).size;

    // 📱 Tablet olup olmadığını kontrol eder (örneğin genişlik 600 pikselden fazlaysa tablet kabul edilir)
    final bool isTablet = screenSize.width > 600;

    // 🔄 Ekranın yatay mı dikey mi olduğunu belirler.
    final bool isLandscape = screenSize.width > screenSize.height;

    return Scaffold(
      // Scaffold: AppBar, Body, BottomNavigation gibi yapı taşlarını içeren temel sayfa yapısıdır.
      body: SafeArea(
        // SafeArea: Çentik (notch) veya sistem çubuğu alanlarına girmeyi engeller.
        child: AnimatedContainer(
          // AnimatedContainer: Boyut veya yer değiştiğinde yumuşak animasyon sağlar.
          duration: const Duration(milliseconds: 500),
          // Cihaz yatay veya dikeyse ona uygun layout çağrılır.
          child: isLandscape
              ? _buildLandscapeLayout(context, isTablet)
              : _buildPortraitLayout(context, isTablet),
        ),
      ),
    );
  }

  // 📱 Dikey düzen (Portrait)
  Widget _buildPortraitLayout(BuildContext context, bool isTablet) {
    return Column(
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        _buildHeaderSection(
          context,
          isTablet,
          false,
        ), // Üst kısım (logo, başlık)
        _buildButtonSection(context, isTablet, false), // Ortadaki butonlar
        _buildFooterSection(context, false), // Alt bilgi
      ],
    );
  }

  // 🌅 Yatay düzen (Landscape)
  Widget _buildLandscapeLayout(BuildContext context, bool isTablet) {
    return Row(
      children: [
        // Sol sütun: Logo ve footer
        Expanded(
          flex: 2, // Sol alan genişliği
          child: Column(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              _buildHeaderSection(context, isTablet, true),
              _buildFooterSection(context, true),
            ],
          ),
        ),
        // Sağ sütun: Butonlar
        Expanded(flex: 3, child: _buildButtonSection(context, isTablet, true)),
      ],
    );
  }

  // 🖼️ Üst bölüm (Logo ve başlık)
  Widget _buildHeaderSection(
    BuildContext context,
    bool isTablet,
    bool isLandscape,
  ) {
    // Ekran konumuna göre logo, başlık ve alt başlık boyutlarını dinamik belirleme
    double logoSize = isLandscape
        ? (isTablet ? 120 : 100)
        : (isTablet ? 220 : 180);

    double titleSize = isLandscape
        ? (isTablet ? 20 : 18)
        : (isTablet ? 32 : 24);

    double subtitleSize = isLandscape
        ? (isTablet ? 14 : 12)
        : (isTablet ? 16 : 14);

    return Flexible(
      flex: isLandscape ? 1 : 3,
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          SizedBox(height: isLandscape ? 20 : 50),
          // Logo
          AnimatedContainer(
            duration: const Duration(milliseconds: 800),
            curve: Curves.easeOutCubic,
            width: logoSize,
            height: logoSize,
            child: Image.asset(
              'assets/logo.png',
              fit: BoxFit.contain,
              filterQuality: FilterQuality.high,
            ),
          ),
          const SizedBox(height: 4),
          // Başlık
          AnimatedDefaultTextStyle(
            duration: const Duration(milliseconds: 500),
            style: Theme.of(context).textTheme.displayMedium!.copyWith(
              fontSize: titleSize,
              letterSpacing: 1.2,
            ),
            child: const Text('WinDesign_Craft Pro'),
          ),
          const SizedBox(height: 8),
          // Alt başlık
          AnimatedOpacity(
            duration: const Duration(milliseconds: 700),
            opacity: 0.7,
            child: Text(
              'PROFESYONEL PVC TASARIMI',
              textAlign: TextAlign.center,
              style: Theme.of(context).textTheme.bodySmall!.copyWith(
                fontSize: subtitleSize,
                letterSpacing: 0.8,
                fontWeight: FontWeight.w500,
              ),
            ),
          ),
          if (isLandscape) const SizedBox(height: 20),
        ],
      ),
    );
  }

  // 🔘 Orta bölüm (Butonlar)
  Widget _buildButtonSection(
    BuildContext context,
    bool isTablet,
    bool isLandscape,
  ) {
    return Flexible(
      flex: isLandscape ? 3 : 4,
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          _buildThemeButton(
            text: 'YENİ PROJE OLUŞTUR',
            onTap: () => _handleButtonTap(context, 0),
            isLandscape: isLandscape,
          ),
          SizedBox(height: isLandscape ? 12 : 16),
          _buildThemeButton(
            text: 'PROJELERİM',
            onTap: () => _handleButtonTap(context, 1),
            isLandscape: isLandscape,
          ),
          SizedBox(height: isLandscape ? 12 : 16),
          _buildThemeButton(
            text: 'AYARLAR',
            onTap: () => _handleButtonTap(context, 2),
            isLandscape: isLandscape,
          ),
          SizedBox(height: isLandscape ? 12 : 16),
          // Kapatma butonu
          _buildCloseButton(context, isLandscape),
          if (isTablet && !isLandscape) const SizedBox(height: 20),
        ],
      ),
    );
  }

  // 📄 Alt bilgi (Footer)
  Widget _buildFooterSection(BuildContext context, bool isLandscape) {
    return Container(
      padding: isLandscape
          ? const EdgeInsets.only(left: 20, bottom: 20)
          : const EdgeInsets.only(bottom: 20),
      child: AnimatedOpacity(
        duration: const Duration(milliseconds: 500),
        opacity: 0.8,
        child: Column(
          crossAxisAlignment: isLandscape
              ? CrossAxisAlignment.start
              : CrossAxisAlignment.center,
          children: [
            Text(
              'UEK DESIGNER',
              style: Theme.of(context).textTheme.bodyMedium!.copyWith(
                fontWeight: FontWeight.w600,
                letterSpacing: isLandscape ? 1.0 : 2.0,
                fontSize: isLandscape ? 12 : 14,
              ),
            ),
            const SizedBox(height: 6),
            Text(
              '© 2025 TÜM HAKLARI SAKLIDIR.',
              style: Theme.of(context).textTheme.bodySmall!.copyWith(
                letterSpacing: isLandscape ? 0.3 : 0.5,
                fontSize: isLandscape ? 10 : 12,
              ),
            ),
          ],
        ),
      ),
    );
  }

  // 🌈 Tema uyumlu buton (genel buton şablonu)
  Widget _buildThemeButton({
    required String text,
    required VoidCallback onTap,
    required bool isLandscape,
  }) {
    return Padding(
      padding: EdgeInsets.symmetric(horizontal: isLandscape ? 30 : 60),
      child: ElevatedButton(
        onPressed: onTap,
        style: ElevatedButton.styleFrom(
          minimumSize: Size(double.infinity, isLandscape ? 50 : 62),
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(isLandscape ? 25 : 35),
          ),
        ),
        child: Text(
          text,
          style: TextStyle(
            fontSize: isLandscape ? 14 : 16,
            fontWeight: FontWeight.w600,
            letterSpacing: isLandscape ? 0.8 : 1.2,
          ),
        ),
      ),
    );
  }

  // ❌ Kapatma butonu
  Widget _buildCloseButton(BuildContext context, bool isLandscape) {
    return Padding(
      padding: EdgeInsets.symmetric(horizontal: isLandscape ? 30 : 60),
      child: OutlinedButton.icon(
        onPressed: () => _closeApp(context),
        icon: Icon(
          Icons.exit_to_app_rounded,
          size: isLandscape ? 18 : 20,
          color: Colors.grey[600],
        ),
        label: Text(
          'UYGULAMADAN ÇIK',
          style: TextStyle(
            fontSize: isLandscape ? 14 : 16,
            fontWeight: FontWeight.w600,
            letterSpacing: isLandscape ? 0.8 : 1.2,
            color: Colors.grey[600],
          ),
        ),
        style: OutlinedButton.styleFrom(
          minimumSize: Size(double.infinity, isLandscape ? 50 : 62),
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(isLandscape ? 25 : 35),
          ),
          side: BorderSide(color: Colors.grey[400]!),
        ),
      ),
    );
  }

  // ❌ Uygulamayı kapatma diyaloğu
  void _closeApp(BuildContext context) {
    showDialog(
      context: context,
      builder: (BuildContext context) {
        return Dialog(
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(20),
          ),
          child: Padding(
            padding: const EdgeInsets.all(24),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Icon(
                  Icons.exit_to_app_rounded,
                  size: 48,
                  color: Colors.grey[700],
                ),
                const SizedBox(height: 16),
                Text(
                  'Çıkış Yap',
                  style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 8),
                Text(
                  'Uygulamadan çıkmak istediğinizden emin misiniz?',
                  textAlign: TextAlign.center,
                  style: TextStyle(fontSize: 16, color: Colors.grey[600]),
                ),
                const SizedBox(height: 24),
                Row(
                  children: [
                    // Vazgeç butonu
                    Expanded(
                      child: OutlinedButton(
                        onPressed: () => Navigator.of(context).pop(),
                        child: const Text('VAZGEÇ'),
                      ),
                    ),
                    const SizedBox(width: 12),
                    // Çıkış butonu
                    Expanded(
                      child: ElevatedButton(
                        onPressed: () {
                          Navigator.of(context).pop();
                          _exitAppSafely(); // Platform uyumlu çıkış
                        },
                        style: ElevatedButton.styleFrom(
                          backgroundColor: Colors.red,
                        ),
                        child: const Text('ÇIKIŞ YAP'),
                      ),
                    ),
                  ],
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  // 🧠 Platforma göre güvenli çıkış işlemi
  void _exitAppSafely() {
    try {
      if (Platform.isAndroid || Platform.isIOS) {
        SystemNavigator.pop(); // Mobilde uygulamayı kapatır.
      } else if (Platform.isWindows || Platform.isLinux || Platform.isMacOS) {
        exit(0); // Masaüstünde programı sonlandırır.
      } else {
        debugPrint("🌐 Web'de uygulama doğrudan kapatılamaz.");
      }
    } catch (e) {
      debugPrint("Çıkış hatası: $e");
    }
  }

  // 🎯 Buton tıklama işleyicisi (sayfa yönlendirme)
  void _handleButtonTap(BuildContext context, int index) {
    _triggerHapticFeedback(); // Titreşim efekti (isteğe bağlı)
    Navigator.of(context).push(
      PageRouteBuilder(
        pageBuilder: (context, animation, secondaryAnimation) {
          switch (index) {
            case 0:
              return const ProjectFormPage(); // Yeni proje sayfası
            case 1:
              return Container(); // Projelerim (gelecekte eklenecek)
            case 2:
              return Container(); // Ayarlar (gelecekte eklenecek)
            default:
              return Container();
          }
        },
        transitionsBuilder: (context, animation, secondaryAnimation, child) {
          const begin = Offset(1.0, 0.0);
          const end = Offset.zero;
          const curve = Curves.easeInOutCubic;
          var tween = Tween(
            begin: begin,
            end: end,
          ).chain(CurveTween(curve: curve));
          return SlideTransition(
            position: animation.drive(tween),
            child: child,
          );
        },
        transitionDuration: const Duration(milliseconds: 600),
      ),
    );
  }

  // 📳 Hafif titreşim (isteğe bağlı)
  void _triggerHapticFeedback() {
    // HapticFeedback.mediumImpact();
  }
}



