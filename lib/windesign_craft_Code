                Text(
                  'Uygulamadan çıkmak istediğinizden emin misiniz?',
                  textAlign: TextAlign.center,
                  style: TextStyle(
                    fontSize: 16 * scaleFactor,
                    color: Colors.grey[600],
                  ),
                ),
