                    child: Text(
                      'Henüz aksesuar yok',
                      style: TextStyle(fontSize: 12, color: Colors.grey),
                    ),
                  )
                : Column(
                    mainAxisSize: MainAxisSize.min,
                    children: _accessories.map((acc) {
                      final id = acc['id'] as int;
                      final name = (acc['name'] as String).capitalize();
