        return Dialog(
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(20 * scaleFactor),
          ),
          child: Padding(
            padding: EdgeInsets.all(24 * scaleFactor),
            child: Column(
              mainAxisSize: MainAxisSize.min,
