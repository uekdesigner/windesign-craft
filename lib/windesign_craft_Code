class LicenseModel {
  final String status; // "trial" | "active" | "locked"
  final String tier; // "trial" | "monthly" | "yearly"
  final DateTime? trialEndsAt; // deneme bitiş tarihi (yoksa null)
  final int projectCount; // oluşturulmuş proje sayısı
  final List<String> pdfProjects; // PDF üretilmiş proje id'leri

  const LicenseModel({
    required this.status,
    required this.tier,
    required this.trialEndsAt,
    required this.projectCount,
    required this.pdfProjects,
  });

  /// Cloud Function'dan dönen map'i modele çevirir.
  factory LicenseModel.fromMap(Map<String, dynamic> map) {
    final endsMs = map['trialEndsAt'];
    return LicenseModel(
      status: (map['status'] ?? 'trial') as String,
      tier: (map['tier'] ?? 'trial') as String,
      trialEndsAt: endsMs == null
          ? null
          : DateTime.fromMillisecondsSinceEpoch((endsMs as num).toInt()),
      projectCount: ((map['projectCount'] ?? 0) as num).toInt(),
      pdfProjects: ((map['pdfProjects'] ?? const <dynamic>[]) as List)
          .map((e) => e.toString())
          .toList(),
    );
  }

  // --- İşe yarayan kısayollar ---

  /// Lisanslı mı? (aylık veya yıllık, aktif durumda)
  bool get isLicensed => status == 'active';

  /// Tamamen kilitli mi? (12 gün doldu, lisans yok)
  bool get isLocked => status == 'locked';

  /// Sınırlı (deneme) modda mı?
  bool get isTrial => status == 'trial';

  /// Denemenin bitmesine kalan gün (negatifse süresi geçmiş).
  int? get trialDaysLeft {
    if (trialEndsAt == null) return null;
    return trialEndsAt!.difference(DateTime.now()).inDays;
  }
}

