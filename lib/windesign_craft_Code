            ],
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(ctx),
              child: const Text('İptal'),
            ),
            ElevatedButton(
              onPressed: () async {
                final amount = double.tryParse(
                  amountCtrl.text.trim().replaceAll(',', '.'),
