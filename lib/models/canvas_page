import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import 'shape_spec.dart';
import '../data/models/drawing_controller';
import '../presentation/painters/quadrilateral_painter.dart';
import '../data/models/scrollable_toolbar.dart';

class CanvasPage extends StatefulWidget {
  final String title;

  const CanvasPage({Key? key, required this.title}) : super(key: key);

  @override
  State<CanvasPage> createState() => _CanvasPageState();
}

class _CanvasPageState extends State<CanvasPage> {
  final TransformationController _transformationController =
      TransformationController();

  double _scale = 1.0;
  Offset _canvasOffset = Offset(50, 50);
  int? _hoveredVertexIndex;
  int? _selectedElementIndex;
  bool _isDraggingVertex = false;
  bool _isDraggingElement = false;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) {
      context.read<DrawingController>().initialize(widget.title);
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(widget.title),
        backgroundColor: Colors.blue.shade900,
        actions: [
          IconButton(
            icon: Icon(Icons.save),
            onPressed: () {
              // Save functionality
              ScaffoldMessenger.of(
                context,
              ).showSnackBar(SnackBar(content: Text('Çizim kaydedildi')));
            },
          ),
        ],
      ),
      body: Consumer<DrawingController>(
        builder: (context, controller, child) {
          return Column(
            children: [
              // Scrollable Toolbar
              ScrollableToolbar(
                onAction: (action) => _handleToolbarAction(action, controller),
                onDragStart: (type) {}, // Drag işlemi DragTarget'ta
                canUndo: controller.canUndo,
                canRedo: controller.canRedo,
                onUndo: controller.undo,
                onRedo: controller.redo,
              ),

              // Canvas Area
              Expanded(
                child: LayoutBuilder(
                  builder: (context, constraints) {
                    return GestureDetector(
                      onPanDown: (details) => _onPanDown(details, controller),
                      onPanUpdate: (details) =>
                          _onPanUpdate(details, controller),
                      onPanEnd: (_) => _onPanEnd(controller),
                      child: Container(
                        color: Colors.grey.shade100,
                        child: InteractiveViewer(
                          transformationController: _transformationController,
                          boundaryMargin: EdgeInsets.all(double.infinity),
                          minScale: 0.1,
                          maxScale: 5.0,
                          child: DragTarget<InternalElementType>(
                            onAcceptWithDetails: (details) {
                              _handleElementDrop(details, controller);
                            },
                            builder: (context, candidateData, rejectedData) {
                              return CustomPaint(
                                size: Size(
                                  constraints.maxWidth,
                                  constraints.maxHeight,
                                ),
                                painter: controller.selectedShape != null
                                    ? QuadrilateralPainter(
                                        shape: controller.selectedShape!,
                                        scale: _scale,
                                        offset: _canvasOffset,
                                        selectedElementIndex:
                                            _selectedElementIndex,
                                      )
                                    : null,
                                foregroundPainter:
                                    controller.selectedShape != null
                                    ? VertexHandlePainter(
                                        vertices: _getVertexPositions(
                                          controller.selectedShape!,
                                        ),
                                        hoveredIndex: _hoveredVertexIndex,
                                      )
                                    : null,
                              );
                            },
                          ),
                        ),
                      ),
                    );
                  },
                ),
              ),

              // Bottom Shape List
              _buildShapeList(controller),
            ],
          );
        },
      ),
    );
  }

  Widget _buildShapeList(DrawingController controller) {
    return Container(
      height: 100,
      decoration: BoxDecoration(
        color: Colors.white,
        boxShadow: [
          BoxShadow(
            color: Colors.black12,
            blurRadius: 4,
            offset: Offset(0, -2),
          ),
        ],
      ),
      child: Row(
        children: [
          Expanded(
            child: ListView.builder(
              scrollDirection: Axis.horizontal,
              padding: EdgeInsets.symmetric(horizontal: 8, vertical: 8),
              itemCount: controller.shapes.length,
              itemBuilder: (context, index) {
                final shape = controller.shapes[index];
                final isSelected = controller.selectedShapeIndex == index;

                return GestureDetector(
                  onTap: () => controller.selectShape(index),
                  child: Container(
                    width: 120,
                    margin: EdgeInsets.symmetric(horizontal: 4),
                    decoration: BoxDecoration(
                      border: Border.all(
                        color: isSelected ? Colors.blue.shade900 : Colors.grey,
                        width: isSelected ? 3 : 1,
                      ),
                      borderRadius: BorderRadius.circular(8),
                      color: isSelected ? Colors.blue.shade50 : Colors.white,
                    ),
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Icon(
                          Icons.crop_square,
                          size: 40,
                          color: isSelected
                              ? Colors.blue.shade900
                              : Colors.grey,
                        ),
                        SizedBox(height: 4),
                        Text(
                          shape.name,
                          style: TextStyle(
                            fontWeight: isSelected
                                ? FontWeight.bold
                                : FontWeight.normal,
                            color: isSelected
                                ? Colors.blue.shade900
                                : Colors.black87,
                          ),
                        ),
                        Text(
                          '${shape.baseWidth.toInt()}x${shape.baseHeight.toInt()}',
                          style: TextStyle(fontSize: 12, color: Colors.grey),
                        ),
                      ],
                    ),
                  ),
                );
              },
            ),
          ),

          // Add Button
          Container(
            width: 80,
            margin: EdgeInsets.all(8),
            child: ElevatedButton(
              onPressed: () => _showNewShapeDialog(controller),
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.green,
                foregroundColor: Colors.white,
              ),
              child: Icon(Icons.add),
            ),
          ),
        ],
      ),
    );
  }

  void _showNewShapeDialog(DrawingController controller) {
    final widthController = TextEditingController(text: '1000');
    final heightController = TextEditingController(text: '1000');

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Text('Yeni Şekil Ekle'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            TextField(
              controller: widthController,
              decoration: InputDecoration(labelText: 'Genişlik (mm)'),
              keyboardType: TextInputType.number,
            ),
            TextField(
              controller: heightController,
              decoration: InputDecoration(labelText: 'Yükseklik (mm)'),
              keyboardType: TextInputType.number,
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: Text('İptal'),
          ),
          ElevatedButton(
            onPressed: () {
              final width = double.tryParse(widthController.text) ?? 1000;
              final height = double.tryParse(heightController.text) ?? 1000;

              final newShape = ShapeSpec(
                id: DateTime.now().millisecondsSinceEpoch.toString(),
                name: '${controller.shapes.length + 1}. Şekil',
                baseWidth: width,
                baseHeight: height,
              );

              controller.addShape(newShape);
              Navigator.pop(context);
            },
            child: Text('Ekle'),
          ),
        ],
      ),
    );
  }

  List<Offset> _getVertexPositions(ShapeSpec shape) {
    return shape.getPolygonPoints().map((p) {
      return Offset(
        _canvasOffset.dx + p.dx * _scale,
        _canvasOffset.dy + p.dy * _scale,
      );
    }).toList();
  }

  void _onPanDown(DragDownDetails details, DrawingController controller) {
    if (controller.selectedShape == null) return;

    final vertices = _getVertexPositions(controller.selectedShape!);
    final touchPos = details.localPosition;

    // Check if touching a vertex
    for (int i = 0; i < vertices.length; i++) {
      if ((vertices[i] - touchPos).distance < 20) {
        setState(() {
          _hoveredVertexIndex = i;
          _isDraggingVertex = true;
        });
        return;
      }
    }

    // Check if touching an internal element
    for (
      int i = 0;
      i < controller.selectedShape!.internalElements.length;
      i++
    ) {
      final element = controller.selectedShape!.internalElements[i];
      final elemPos = Offset(
        _canvasOffset.dx + element.position.dx * _scale,
        _canvasOffset.dy + element.position.dy * _scale,
      );
      if ((elemPos - touchPos).distance < 20) {
        setState(() {
          _selectedElementIndex = i;
          _isDraggingElement = true;
        });
        return;
      }
    }
  }

  void _onPanUpdate(DragUpdateDetails details, DrawingController controller) {
    if (!_isDraggingVertex && !_isDraggingElement) return;
    if (controller.selectedShape == null) return;

    final delta = details.delta / _scale; // mm cinsinden delta

    if (_isDraggingVertex && _hoveredVertexIndex != null) {
      _updateCropValues(controller, _hoveredVertexIndex!, delta);
    } else if (_isDraggingElement && _selectedElementIndex != null) {
      _updateElementPosition(controller, _selectedElementIndex!, delta);
    }
  }

  void _updateCropValues(
    DrawingController controller,
    int vertexIndex,
    Offset delta,
  ) {
    final shape = controller.selectedShape!;
    ShapeSpec newShape = shape;

    // Vertex index'e göre hangi crop değerini güncelle
    // 0-1: Top-left, 2-3: Top-right, 4-5: Bottom-right, 6-7: Bottom-left
    switch (vertexIndex) {
      case 0: // Top-left X
        newShape = shape.copyWith(
          topLeftX: (shape.topLeftX + delta.dx).clamp(0, shape.baseWidth),
        );
        break;
      case 1: // Top-left Y
        newShape = shape.copyWith(
          topLeftY: (shape.topLeftY + delta.dy).clamp(0, shape.baseHeight),
        );
        break;
      case 2: // Top-right X
        newShape = shape.copyWith(
          topRightX: (shape.topRightX - delta.dx).clamp(0, shape.baseWidth),
        );
        break;
      case 3: // Top-right Y
        newShape = shape.copyWith(
          topRightY: (shape.topRightY + delta.dy).clamp(0, shape.baseHeight),
        );
        break;
      case 4: // Bottom-right X
        newShape = shape.copyWith(
          bottomRightX: (shape.bottomRightX - delta.dx).clamp(
            0,
            shape.baseWidth,
          ),
        );
        break;
      case 5: // Bottom-right Y
        newShape = shape.copyWith(
          bottomRightY: (shape.bottomRightY - delta.dy).clamp(
            0,
            shape.baseHeight,
          ),
        );
        break;
      case 6: // Bottom-left X
        newShape = shape.copyWith(
          bottomLeftX: (shape.bottomLeftX + delta.dx).clamp(0, shape.baseWidth),
        );
        break;
      case 7: // Bottom-left Y
        newShape = shape.copyWith(
          bottomLeftY: (shape.bottomLeftY - delta.dy).clamp(
            0,
            shape.baseHeight,
          ),
        );
        break;
    }

    controller.updateSelectedShape(newShape);
  }

  void _updateElementPosition(
    DrawingController controller,
    int elementIndex,
    Offset delta,
  ) {
    final shape = controller.selectedShape!;
    final element = shape.internalElements[elementIndex];

    final newPosition = Offset(
      (element.position.dx + delta.dx).clamp(
        0,
        shape.baseWidth - element.size.width,
      ),
      (element.position.dy + delta.dy).clamp(
        0,
        shape.baseHeight - element.size.height,
      ),
    );

    final updatedElements = [...shape.internalElements];
    updatedElements[elementIndex] = element.copyWith(position: newPosition);

    controller.updateSelectedShape(
      shape.copyWith(internalElements: updatedElements),
    );
  }

  void _onPanEnd(DrawingController controller) {
    setState(() {
      _hoveredVertexIndex = null;
      _isDraggingVertex = false;
      _isDraggingElement = false;
    });
  }

  void _handleElementDrop(
    DragTargetDetails<InternalElementType> details,
    DrawingController controller,
  ) {
    if (controller.selectedShape == null) return;

    final type = details.data;
    final localPos = details.offset;

    // Convert to canvas coordinates
    final renderBox = context.findRenderObject() as RenderBox;
    final localOffset = renderBox.globalToLocal(localPos);

    // Convert to mm coordinates
    final mmX = (localOffset.dx - _canvasOffset.dx) / _scale;
    final mmY = (localOffset.dy - _canvasOffset.dy) / _scale;

    // Ensure within shape bounds
    final clampedX = mmX.clamp(0.0, controller.selectedShape!.baseWidth);
    final clampedY = mmY.clamp(0.0, controller.selectedShape!.baseHeight);

    final newElement = InternalElement(
      id: DateTime.now().millisecondsSinceEpoch.toString(),
      type: type,
      position: Offset(clampedX, clampedY),
      size: Size(100, 100), // Default size in mm
    );

    controller.addInternalElement(newElement);
  }

  void _handleToolbarAction(String action, DrawingController controller) {
    switch (action) {
      case 'select':
        setState(() => _selectedElementIndex = null);
        break;
      case 'delete':
        if (_selectedElementIndex != null) {
          final shape = controller.selectedShape!;
          final updated = [...shape.internalElements];
          updated.removeAt(_selectedElementIndex!);
          controller.updateSelectedShape(
            shape.copyWith(internalElements: updated),
          );
          setState(() => _selectedElementIndex = null);
        } else {
          controller.deleteSelectedShape();
        }
        break;
    }
  }
}
