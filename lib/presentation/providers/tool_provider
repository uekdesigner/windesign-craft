// lib/providers/tool_provider.dart
// Bu dosya, araç modu state management'ını sağlar; kullanıcının seçtiği çizim aracını takip eder.
// İşlev: Uygulamanın araç durumunu merkezi şekilde yönetir, çizim modları arasında geçiş sağlar.

import 'package:flutter_riverpod/flutter_riverpod.dart'; // Riverpod state management

// =============================================================================
// TOOL MODE CONSTANTS
// =============================================================================

/// Araç modu sabitleri - tüm olası çizim ve düzenleme modları
class ToolModes {
  static const String none = 'none'; // Hiçbir araç seçili değil
  static const String select = 'select'; // Şekil seçim modu
  static const String move = 'move'; // Şekil taşıma modu
  static const String resize = 'resize'; // Şekil boyutlandırma modu
  static const String rectangle = 'rectangle'; // Dikdörtgen çizim modu
  static const String polygon = 'polygon'; // Polygon çizim modu
  static const String line = 'line'; // Çizgi çizim modu
  static const String placeVertical =
      'placeVertical'; // Dikey çizgi yerleştirme modu
  static const String measure = 'measure'; // Ölçüm modu
  static const String crop = 'crop'; // Kırpma modu
  static const String pan = 'pan'; // Sayfa kaydırma modu
  static const String zoom = 'zoom'; // Yakınlaştırma modu

  /// 🔧 YENİ: Geçerli araç modu kontrolü
  ///
  /// @param mode: Kontrol edilecek mod
  /// @return: Mod geçerliyse true
  static bool isValidMode(String mode) {
    return [
      none,
      select,
      move,
      resize,
      rectangle,
      polygon,
      line,
      placeVertical,
      measure,
      crop,
      pan,
      zoom,
    ].contains(mode);
  }

  /// 🔧 YENİ: Çizim modu kontrolü
  ///
  /// @param mode: Kontrol edilecek mod
  /// @return: Çizim moduysa true
  static bool isDrawingMode(String mode) {
    return [rectangle, polygon, line, placeVertical].contains(mode);
  }

  /// 🔧 YENİ: Düzenleme modu kontrolü
  ///
  /// @param mode: Kontrol edilecek mod
  /// @return: Düzenleme moduysa true
  static bool isEditingMode(String mode) {
    return [select, move, resize, crop, measure].contains(mode);
  }

  /// 🔧 YENİ: Görüntüleme modu kontrolü
  ///
  /// @param mode: Kontrol edilecek mod
  /// @return: Görüntüleme moduysa true
  static bool isViewingMode(String mode) {
    return [pan, zoom, none].contains(mode);
  }
}

// =============================================================================
// TOOL STATE MANAGEMENT
// =============================================================================

/// Araç state'ini tutan immutable veri sınıfı
///
/// Mevcut araç modu ve ek araç özelliklerini içerir.
class ToolState {
  final String currentMode; // Mevcut araç modu
  final Map<String, dynamic> properties; // Araç özellikleri

  /// Constructor
  ///
  /// @param currentMode: Mevcut araç modu - varsayılan 'none'
  /// @param properties: Araç özellikleri - varsayılan boş map
  const ToolState({
    this.currentMode = ToolModes.none,
    this.properties = const {},
  });

  /// 🔧 YENİ: Çizim modu kontrolü
  bool get isDrawingMode => ToolModes.isDrawingMode(currentMode);

  /// 🔧 YENİ: Düzenleme modu kontrolü
  bool get isEditingMode => ToolModes.isEditingMode(currentMode);

  /// 🔧 YENİ: Görüntüleme modu kontrolü
  bool get isViewingMode => ToolModes.isViewingMode(currentMode);

  /// 🔧 YENİ: Seçim modu kontrolü
  bool get isSelectMode => currentMode == ToolModes.select;

  /// 🔧 YENİ: Özellik değeri getirme
  ///
  /// @param key: Özellik anahtarı
  /// @return: Özellik değeri veya null
  dynamic getProperty(String key) => properties[key];

  /// 🔧 YENİ: Özellik değeri kontrolü
  ///
  /// @param key: Özellik anahtarı
  /// @return: Özellik varsa true
  bool hasProperty(String key) => properties.containsKey(key);

  /// Durum kopyalama metodu (immutable update için)
  ///
  /// @param currentMode: Yeni araç modu (opsiyonel)
  /// @param properties: Yeni araç özellikleri (opsiyonel)
  /// @return: Güncellenmiş ToolState kopyası
  ToolState copyWith({String? currentMode, Map<String, dynamic>? properties}) {
    return ToolState(
      currentMode: currentMode ?? this.currentMode,
      properties: properties ?? this.properties,
    );
  }

  /// 🔧 YENİ: Özellik ekleme/güncelleme metodu
  ///
  /// @param key: Özellik anahtarı
  /// @param value: Özellik değeri
  /// @return: Güncellenmiş ToolState kopyası
  ToolState withProperty(String key, dynamic value) {
    final newProperties = Map<String, dynamic>.from(properties);
    newProperties[key] = value;

    return copyWith(properties: newProperties);
  }

  /// 🔧 YENİ: Özellik kaldırma metodu
  ///
  /// @param key: Kaldırılacak özellik anahtarı
  /// @return: Güncellenmiş ToolState kopyası
  ToolState withoutProperty(String key) {
    final newProperties = Map<String, dynamic>.from(properties);
    newProperties.remove(key);

    return copyWith(properties: newProperties);
  }

  /// 🔧 YENİ: Debug için string temsili
  @override
  String toString() {
    return 'ToolState(mode: $currentMode, '
        'properties: ${properties.keys.length}, '
        'isDrawing: $isDrawingMode, '
        'isEditing: $isEditingMode)';
  }
}

/// Araç state'ini yöneten notifier sınıfı
class ToolNotifier extends StateNotifier<ToolState> {
  /// Constructor: Varsayılan ToolState ile başlar
  ToolNotifier() : super(const ToolState());

  /// Araç modunu değiştirir
  ///
  /// @param mode: Yeni araç modu
  void setToolMode(String mode) {
    // Geçerlilik kontrolü
    if (!ToolModes.isValidMode(mode)) {
      throw Exception('Geçersiz araç modu: $mode');
    }

    // Aynı moda geçişte özellikleri temizle
    if (state.currentMode == mode) {
      state = state.copyWith(properties: const {});
    } else {
      state = state.copyWith(currentMode: mode, properties: const {});
    }
  }

  /// 🔧 YENİ: Araç modunu sıfırlar (none moduna geçer)
  void resetToolMode() {
    state = const ToolState(currentMode: ToolModes.none, properties: {});
  }

  /// 🔧 YENİ: Belirli bir moda geçici olarak geçer
  ///
  /// @param tempMode: Geçici mod
  /// @param originalMode: Orijinal mod (kaydedilir)
  void setTemporaryMode(String tempMode, {String? originalMode}) {
    if (!ToolModes.isValidMode(tempMode)) {
      throw Exception('Geçersiz geçici araç modu: $tempMode');
    }

    final original = originalMode ?? state.currentMode;
    state = state.copyWith(
      currentMode: tempMode,
      properties: {'originalMode': original},
    );
  }

  /// 🔧 YENİ: Geçici moddan önceki moda döner
  void restoreOriginalMode() {
    final originalMode = state.getProperty('originalMode');
    if (originalMode is String && ToolModes.isValidMode(originalMode)) {
      state = state.copyWith(currentMode: originalMode, properties: const {});
    } else {
      resetToolMode();
    }
  }

  /// 🔧 YENİ: Araç özelliği ekler/günceller
  ///
  /// @param key: Özellik anahtarı
  /// @param value: Özellik değeri
  void setProperty(String key, dynamic value) {
    final newProperties = Map<String, dynamic>.from(state.properties);
    newProperties[key] = value;

    state = state.copyWith(properties: newProperties);
  }

  /// 🔧 YENİ: Araç özelliğini kaldırır
  ///
  /// @param key: Kaldırılacak özellik anahtarı
  void removeProperty(String key) {
    final newProperties = Map<String, dynamic>.from(state.properties);
    newProperties.remove(key);

    state = state.copyWith(properties: newProperties);
  }

  /// 🔧 YENİ: Tüm araç özelliklerini temizler
  void clearProperties() {
    state = state.copyWith(properties: const {});
  }

  /// 🔧 YENİ: Çizim moduna geçer
  void setDrawingMode() {
    setToolMode(ToolModes.rectangle); // Varsayılan çizim modu
  }

  /// 🔧 YENİ: Seçim moduna geçer
  void setSelectionMode() {
    setToolMode(ToolModes.select);
  }

  /// 🔧 YENİ: Düzenleme moduna geçer
  void setEditingMode() {
    setToolMode(ToolModes.move); // Varsayılan düzenleme modu
  }

  /// 🔧 YENİ: Görüntüleme moduna geçer
  void setViewingMode() {
    setToolMode(ToolModes.pan); // Varsayılan görüntüleme modu
  }

  /// 🔧 YENİ: Dikey çizgi moduna geçer
  void setVerticalLineMode() {
    setToolMode(ToolModes.placeVertical);
  }
}

// =============================================================================
// PROVIDERS
// =============================================================================

/// ToolNotifier'ı sağlayan Riverpod StateNotifierProvider'ı
///
/// Kullanım: ref.watch/ref.read ile erişilir
final toolProvider = StateNotifierProvider<ToolNotifier, ToolState>((ref) {
  return ToolNotifier();
});
