// lib/providers/helper_lines_provider.dart
import 'package:flutter_riverpod/flutter_riverpod.dart';

class HelperLinesState {
  final Map<int, List<double>> linesByShape;

  const HelperLinesState({this.linesByShape = const {}});

  List<double> getLinesForShape(int shapeIndex) {
    return linesByShape[shapeIndex] ?? [];
  }

  int getLineCountForShape(int shapeIndex) {
    return getLinesForShape(shapeIndex).length;
  }

  int get totalLineCount {
    return linesByShape.values.fold(0, (sum, lines) => sum + lines.length);
  }

  int get shapeCountWithLines {
    return linesByShape.keys.length;
  }

  bool hasLinesForShape(int shapeIndex) {
    return getLinesForShape(shapeIndex).isNotEmpty;
  }

  bool hasLineAtPosition(int shapeIndex, double xmm, [double tolerance = 1.0]) {
    final lines = getLinesForShape(shapeIndex);
    return lines.any((line) => (line - xmm).abs() <= tolerance);
  }

  HelperLinesState copyWith({Map<int, List<double>>? linesByShape}) {
    return HelperLinesState(linesByShape: linesByShape ?? this.linesByShape);
  }

  @override
  String toString() {
    return 'HelperLinesState(shapes: $shapeCountWithLines, totalLines: $totalLineCount)';
  }
}

class HelperLinesNotifier extends StateNotifier<HelperLinesState> {
  HelperLinesNotifier() : super(const HelperLinesState());

  List<double> _getLinesForShape(int shapeIndex) {
    return List<double>.from(state.linesByShape[shapeIndex] ?? []);
  }

  void addLine(int shapeIndex, double xmm) {
    if (shapeIndex < 0) {
      throw Exception('Geçersiz şekil indeksi: $shapeIndex');
    }

    if (state.hasLineAtPosition(shapeIndex, xmm)) {
      throw Exception('Bu konumda zaten bir çizgi mevcut: $xmm mm');
    }

    final lines = _getLinesForShape(shapeIndex)..add(xmm);
    lines.sort();

    final newLinesByShape = {...state.linesByShape, shapeIndex: lines};
    state = state.copyWith(linesByShape: newLinesByShape);
  }

  void addLines(int shapeIndex, List<double> xPositions) {
    if (shapeIndex < 0) {
      throw Exception('Geçersiz şekil indeksi: $shapeIndex');
    }

    final lines = _getLinesForShape(shapeIndex);

    for (final xmm in xPositions) {
      if (!state.hasLineAtPosition(shapeIndex, xmm)) {
        lines.add(xmm);
      }
    }

    lines.sort();
    final newLinesByShape = {...state.linesByShape, shapeIndex: lines};
    state = state.copyWith(linesByShape: newLinesByShape);
  }

  void moveLine(int shapeIndex, int lineIndex, double newXmm) {
    final lines = _getLinesForShape(shapeIndex);

    if (lineIndex < 0 || lineIndex >= lines.length) {
      throw Exception('Geçersiz çizgi indeksi: $lineIndex');
    }

    int? existingIndex;
    for (int i = 0; i < lines.length; i++) {
      if (i != lineIndex && (lines[i] - newXmm).abs() <= 1.0) {
        existingIndex = i;
        break;
      }
    }

    if (existingIndex != null) {
      throw Exception('Bu konumda zaten başka bir çizgi mevcut: $newXmm mm');
    }

    lines[lineIndex] = newXmm;
    lines.sort();

    final newLinesByShape = {...state.linesByShape, shapeIndex: lines};
    state = state.copyWith(linesByShape: newLinesByShape);
  }

  void removeLine(int shapeIndex, int lineIndex) {
    final lines = _getLinesForShape(shapeIndex);

    if (lineIndex < 0 || lineIndex >= lines.length) {
      throw Exception('Geçersiz çizgi indeksi: $lineIndex');
    }

    lines.removeAt(lineIndex);

    final newLinesByShape = {...state.linesByShape, shapeIndex: lines};
    state = state.copyWith(linesByShape: newLinesByShape);
  }

  bool removeLineAtPosition(
    int shapeIndex,
    double xmm, [
    double tolerance = 1.0,
  ]) {
    final lines = _getLinesForShape(shapeIndex);
    final index = lines.indexWhere((line) => (line - xmm).abs() <= tolerance);

    if (index != -1) {
      lines.removeAt(index);
      final newLinesByShape = {...state.linesByShape, shapeIndex: lines};
      state = state.copyWith(linesByShape: newLinesByShape);
      return true;
    }

    return false;
  }

  void clearForShape(int shapeIndex) {
    final newLinesByShape = Map<int, List<double>>.from(state.linesByShape);
    newLinesByShape.remove(shapeIndex);
    state = state.copyWith(linesByShape: newLinesByShape);
  }

  void clearAll() {
    state = const HelperLinesState(linesByShape: {});
  }

  void setLinesForShape(int shapeIndex, List<double> xPositions) {
    if (shapeIndex < 0) {
      throw Exception('Geçersiz şekil indeksi: $shapeIndex');
    }

    final uniquePositions = xPositions.toSet().toList()..sort();

    final newLinesByShape = {
      ...state.linesByShape,
      shapeIndex: uniquePositions,
    };
    state = state.copyWith(linesByShape: newLinesByShape);
  }

  void snapLineToGrid(
    int shapeIndex,
    int lineIndex, [
    double gridSize = 100.0,
  ]) {
    final lines = _getLinesForShape(shapeIndex);

    if (lineIndex < 0 || lineIndex >= lines.length) {
      throw Exception('Geçersiz çizgi indeksi: $lineIndex');
    }

    final currentX = lines[lineIndex];
    final snappedX = (currentX / gridSize).round() * gridSize;

    moveLine(shapeIndex, lineIndex, snappedX);
  }

  void snapAllLinesToGrid([double gridSize = 100.0]) {
    final newLinesByShape = <int, List<double>>{};

    for (final entry in state.linesByShape.entries) {
      final shapeIndex = entry.key;
      final lines = entry.value;

      final snappedLines =
          lines.map((x) => (x / gridSize).round() * gridSize).toList()..sort();

      newLinesByShape[shapeIndex] = snappedLines;
    }

    state = state.copyWith(linesByShape: newLinesByShape);
  }

  void copyLinesToShape(int fromShapeIndex, int toShapeIndex) {
    if (fromShapeIndex < 0 || toShapeIndex < 0) {
      throw Exception('Geçersiz şekil indeksi');
    }

    final sourceLines = _getLinesForShape(fromShapeIndex);
    setLinesForShape(toShapeIndex, sourceLines);
  }
}

final helperLinesProvider =
    StateNotifierProvider<HelperLinesNotifier, HelperLinesState>(
      (ref) => HelperLinesNotifier(),
    );
